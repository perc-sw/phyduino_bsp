{
  "version": 6,
  "configurePresets": [
    {
      "name": "phyduino_pico",
      "displayName": "Phyduino Pico (RP2040)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "PHYDUINO_BOARD": "phyduino_pico",
        "PHYDUINO_OS": "none",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "phyduino_pico_freertos",
      "displayName": "Phyduino Pico (RP2040) with FreeRTOS",
      "inherits": "phyduino_pico",
      "cacheVariables": {
        "PHYDUINO_OS": "freertos"
      }
    }
  ],
  "buildPresets": [
    { "name": "phyduino_pico", "configurePreset": "phyduino_pico" },
    { "name": "phyduino_pico_freertos", "configurePreset": "phyduino_pico_freertos" }
  ],
  "workflowPresets": [
    {
      "name": "phyduino_pico",
      "steps": [
        { "type": "configure", "name": "phyduino_pico" },
        { "type": "build",     "name": "phyduino_pico" }
      ]
    },
    {
      "name": "phyduino_pico_freertos",
      "steps": [
        { "type": "configure", "name": "phyduino_pico_freertos" },
        { "type": "build",     "name": "phyduino_pico_freertos" }
      ]
    }
  ]
}

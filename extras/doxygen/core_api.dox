/**
 * @typedef PinStatus
 * @ingroup core_types
 * @brief Pin levels for digitalWrite() and digitalRead(), and interrupt modes for attachInterrupt().
 */
/// @var PinStatus LOW
/// 0 V; for attachInterrupt(), while the pin is low.
/// @var PinStatus HIGH
/// 3.3 V; for attachInterrupt(), while the pin is high.
/// @var PinStatus CHANGE
/// attachInterrupt(): on every rising and falling edge.
/// @var PinStatus FALLING
/// attachInterrupt(): when the pin goes from high to low.
/// @var PinStatus RISING
/// attachInterrupt(): when the pin goes from low to high.

/**
 * @typedef PinMode
 * @ingroup core_types
 * @brief Pin modes for pinMode().
 */
/// @var PinMode INPUT
/// Input with no pull resistor.
/// @var PinMode OUTPUT
/// Output, driven high or low.
/// @var PinMode INPUT_PULLUP
/// Input with the internal pull-up resistor.
/// @var PinMode INPUT_PULLDOWN
/// Input with the internal pull-down resistor.
/// @var PinMode OUTPUT_OPENDRAIN
/// Output driven low, or released for HIGH.

/**

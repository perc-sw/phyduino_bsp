/*
 * Documents the standard Arduino API that the Phyduino core implements. The
 * declarations are in the vendored platform/cores/phyduino/api/Common.h, which
 * must not be edited (api/UPSTREAM.md), so the documentation lives here.
 *
 * Each entry gives the usual Arduino meaning plus what is different on
 * Phyduino boards. Keep it in step with the implementations in
 * platform/cores/phyduino/ (wiring_*.cpp, pwm.cpp, tone.cpp, random.cpp,
 * main.cpp, freertos.cpp); Doxygen warns if a declaration here no longer matches Common.h.
 */

/**
 * @file Common.h
 * @brief Standard Arduino functions, constants and types (from ArduinoCore-API).
 *
 * Included by Arduino.h, so sketches never include it themselves. The
 * functions are grouped by topic under Topics. See the
 * [Arduino language reference](https://docs.arduino.cc/language-reference/)
 * for the general behaviour; the notes here give what is different on
 * Phyduino boards.
 */

/* ============================================================================ */
/*  Topics                                                                       */
/* ============================================================================ */

/**
 * @defgroup core_digital Digital I/O
 * @brief pinMode(), digitalWrite(), digitalRead().
 *
 * All pins are 3.3 V. A3-A5 are analog only: digital functions ignore them.
 */

/**
 * @defgroup core_analog Analog I/O
 * @brief analogRead(), analogWrite() (PWM) and their settings, plus
 *        averaging, millivolts, differential, several pins at once and
 *        fixed-rate bursts on every analog pin.
 *
 * A0-A2 use the RP2040 ADC (0-3.3 V); A3-A5 use the on-board MAX11635 ADC
 * (0-2.048 V). Every function here works on all six, so a sketch does not
 * need to know which ADC a pin uses. analogWrite() is PWM and works on every
 * pin except A3-A5. Examples: File → Examples → Phyduino.
 */

/**
 * @defgroup core_advanced Advanced I/O
 * @brief tone(), pulseIn(), shiftOut(), shiftIn().
 */

/**
 * @defgroup core_time Time
 * @brief millis(), micros(), delay(), delayMicroseconds().
 *
 * All use the RP2040's microsecond timer, so they are exact at every
 * Tools > CPU Speed setting.
 */

/**
 * @defgroup core_interrupts Interrupts
 * @brief attachInterrupt(), detachInterrupt(), interrupts(), noInterrupts().
 */

/**
 * @defgroup core_math Math
 * @brief min(), max(), constrain(), map(), sq() and angle conversions.
 */

/**
 * @defgroup core_random Random numbers
 * @brief random(), randomSeed().
 */

/**
 * @defgroup core_bits Bits and bytes
 * @brief Reading and setting bits, splitting and joining bytes.
 */

/**
 * @defgroup core_sketch Sketch structure
 * @brief setup(), loop() and the start-up order.
 *
 * Start-up: init() (core), then initVariant() (board), then setup() once,
 * then loop() forever. A sketch that also defines setup1() and loop1() runs
 * them on the second core at the same time (@ref core_multicore).
 */

/**
 * @defgroup core_multicore Multicore
 * @brief setup1(), loop1() and `rp2040`: running code on both RP2040 cores.
 *
 * The RP2040 has two cores. setup() and loop() run on core 0. If the sketch
 * also defines setup1() and loop1(), core 1 runs them at the same time:
 *
 * @code
 * void setup()  { Serial.begin(115200); }
 * void loop()   { Serial.println(rp2040.fifo.pop()); }   // waits for core 1
 * void setup1() {}
 * void loop1()  { rp2040.fifo.push(analogRead(A0)); delay(500); }
 * @endcode
 *
 * The names are those of the arduino-pico core, so multicore sketches written
 * for it build here too (ADR 009).
 *
 * | | Tools > Operating System: None | FreeRTOS (SMP), or with CMSIS-RTOS2 |
 * |---|---|---|
 * | setup()/loop() | core 0, 4 KB stack | task pinned to core 0, 8 KB stack, priority 1 (CMSIS-RTOS2: osPriorityNormal) |
 * | setup1()/loop1() | core 1, 4 KB stack, started just before setup() | task pinned to core 1, 8 KB stack, priority 1 (CMSIS-RTOS2: osPriorityNormal) |
 * | delay() | waits, calling yield() | blocks the task: other tasks run |
 *
 * Both cores share the pins, peripherals and memory:
 * - Variables shared between the cores must be `volatile`, or passed through
 *   `rp2040.fifo`.
 * - `Serial` (USB) can be used from both cores. `Serial1` and `Serial2` can
 *   be read on either core, whichever called begin().
 * - Other peripherals (analog pins, `SPI`, `Wire`, a PWM pin or `tone()`)
 *   should be used from one core at a time.
 * - noInterrupts() stops interrupts on the calling core only.
 * - Do not use the pico-sdk's multicore_fifo_*() functions: the hardware FIFO
 *   is used by rp2040.idleOtherCore() and by FreeRTOS.
 */

/**
 * @defgroup core_freertos FreeRTOS
 * @brief Tools > Operating System > FreeRTOS (SMP): tasks, queues and semaphores on both cores.
 *
 * Choosing FreeRTOS (SMP) in Tools > Operating System builds the sketch with
 * the FreeRTOS kernel (ADR 009). A sketch then includes the FreeRTOS headers
 * it uses: `FreeRTOS.h` first, then `task.h`, `queue.h`, `semphr.h`,
 * `event_groups.h`, `timers.h`, `stream_buffer.h` or `message_buffer.h`. The
 * functions are described in the
 * [FreeRTOS kernel API reference](https://www.freertos.org/Documentation/02-Kernel/04-API-references/01-Task-creation/00-TaskHandle).
 * Without the menu option, including `FreeRTOS.h` stops the build with a
 * message naming the menu. FreeRTOS (SMP) + CMSIS-RTOS2 gives the same
 * kernel and settings, plus ARM's CMSIS-RTOS2 API (@ref core_cmsis_rtos2).
 *
 * setup()/loop() and setup1()/loop1() become tasks (see @ref core_multicore).
 * One scheduler runs tasks on both cores; xTaskCreate() lets a task run on
 * either, xTaskCreateAffinitySet() or vTaskCoreAffinitySet() pins it to one.
 *
 * | Setting | Value |
 * |---|---|
 * | Cores | 2 (SMP); the tick runs on core 0 |
 * | Tick | 1 ms (`configTICK_RATE_HZ` 1000), so pdMS_TO_TICKS(ms) is ms |
 * | Priorities | 0 (idle) to 55 (`configMAX_PRIORITIES` 56, the number CMSIS-RTOS2 needs); loop() and loop1() run at 1 (23 with CMSIS-RTOS2), the timer task at 55 |
 * | Pre-emption | On, with time slicing between tasks of equal priority |
 * | Stack sizes | In 4-byte words: xTaskCreate(f, "name", 1024, ...) gives 4 KB; minimum 256 |
 * | Memory | heap_3: tasks and queues come from the same heap as `new`, malloc() and String (rp2040.getFreeHeap()) |
 * | Static allocation | Also available (xTaskCreateStatic()) |
 * | Kernel objects | Mutexes, recursive mutexes, counting semaphores, queue sets, task notifications (3 per task), software timers, event groups, stream and message buffers |
 * | Diagnostics | uxTaskGetStackHighWaterMark(), vTaskListTasks(), uxTaskGetSystemState() |
 *
 * The configuration is built into the package (`FreeRTOSConfig.h` in
 * `sdk-builder/freertos/`); a sketch cannot change it.
 *
 * What changes in the Arduino functions:
 * - delay() blocks the calling task, so other tasks run; delayMicroseconds()
 *   still busy-waits.
 * - The default yield() lets other tasks of the same priority run.
 * - pico-sdk mutexes, semaphores, queues and sleep_ms() block the task
 *   instead of spinning.
 * - A task that never waits (no delay(), vTaskDelay() or blocking queue call)
 *   keeps lower-priority tasks on its core from running.
 *
 * Errors stop the board (USB Serial disconnects): a task overflowing its
 * stack, running out of heap memory, or a failed kernel check. A sketch can
 * define its own `vApplicationStackOverflowHook(TaskHandle_t, char*)` and
 * `vApplicationMallocFailedHook()` (both `extern "C"`) to do something else.
 */

/**
 * @defgroup core_cmsis_rtos2 CMSIS-RTOS2
 * @brief Tools > Operating System > FreeRTOS (SMP) + CMSIS-RTOS2: ARM's standard RTOS API, on FreeRTOS.
 *
 * CMSIS-RTOS2 is the RTOS API of ARM's Cortex-M software standard (CMSIS),
 * used by Keil MDK, STM32Cube and others, so code written for it on other
 * Cortex-M boards runs here unchanged. Choosing FreeRTOS (SMP) + CMSIS-RTOS2
 * in Tools > Operating System builds the sketch with FreeRTOS, as
 * @ref core_freertos describes, plus ARM's CMSIS-RTOS2 layer for FreeRTOS
 * (CMSIS-FreeRTOS; ADR 010). A sketch includes `cmsis_os2.h`. The functions
 * are described in the
 * [CMSIS-RTOS2 API reference](https://arm-software.github.io/CMSIS_6/latest/RTOS2/group__CMSIS__RTOS.html).
 * Without the menu option, including `cmsis_os2.h` stops the build with a
 * message naming the menu option.
 *
 * @code
 * #include <cmsis_os2.h>
 *
 * void blink(void*) {
 *     for (;;) { digitalWrite(LED_BUILTIN, !digitalRead(LED_BUILTIN)); osDelay(500); }
 * }
 *
 * void setup() {
 *     pinMode(LED_BUILTIN, OUTPUT);
 *     osThreadNew(blink, nullptr, nullptr);  // default attributes: osPriorityNormal, 1 KB stack
 * }
 *
 * void loop() {}
 * @endcode
 *
 * Differences from CMSIS-RTOS2 on other systems:
 * - The kernel is already running when setup() starts. osKernelInitialize()
 *   and osKernelStart() are not needed; they return `osError`.
 * - setup()/loop() and setup1()/loop1() are threads at `osPriorityNormal`
 *   (see @ref core_multicore), the default for osThreadNew().
 * - `osPriority_t` p is FreeRTOS priority p - 1: `osPriorityIdle` (1) is the
 *   idle priority 0, `osPriorityNormal` (24) is 23, `osPriorityISR` (56) is
 *   55, the FreeRTOS timer task's priority.
 * - `stack_size` in `osThreadAttr_t` is in bytes (FreeRTOS's xTaskCreate()
 *   takes 4-byte words); 0 or no attributes gives 1 KB.
 * - A tick is 1 ms: osDelay(), timeouts and osKernelGetTickCount() count
 *   milliseconds; osKernelGetTickFreq() is 1000.
 * - osKernelGetSysTimerFreq() is the CPU clock (Tools > CPU Speed).
 *   osKernelGetSysTimerCount() counts CPU clock cycles on core 0, but on core
 *   1 it only moves on once per tick, because the tick timer runs on core 0.
 * - `affinity_mask` in `osThreadAttr_t` and osThreadSetAffinityMask() pin a
 *   thread to cores (`osThreadProcessor(0)`, `osThreadProcessor(1)`, or
 *   both ORed together); 0 means either core.
 * - FreeRTOS functions can be used in the same sketch: an `osThreadId_t` is
 *   a FreeRTOS `TaskHandle_t`.
 * - Errors stop the board, with the same hook functions as @ref core_freertos.
 *
 * Functions provided:
 *
 * | Group | Functions |
 * |---|---|
 * | Kernel | osKernelInitialize(), osKernelGetInfo(), osKernelGetState(), osKernelStart(), osKernelLock(), osKernelUnlock(), osKernelRestoreLock(), osKernelGetTickCount(), osKernelGetTickFreq(), osKernelGetSysTimerCount(), osKernelGetSysTimerFreq() |
 * | Threads | osThreadNew(), osThreadGetName(), osThreadGetId(), osThreadGetState(), osThreadGetStackSpace(), osThreadSetPriority(), osThreadGetPriority(), osThreadYield(), osThreadSuspend(), osThreadResume(), osThreadExit(), osThreadTerminate(), osThreadGetCount(), osThreadEnumerate(), osThreadSetAffinityMask(), osThreadGetAffinityMask() |
 * | Thread flags | osThreadFlagsSet(), osThreadFlagsClear(), osThreadFlagsGet(), osThreadFlagsWait() |
 * | Waiting | osDelay(), osDelayUntil() |
 * | Timers | osTimerNew(), osTimerGetName(), osTimerStart(), osTimerStop(), osTimerIsRunning(), osTimerDelete() |
 * | Event flags | osEventFlagsNew(), osEventFlagsSet(), osEventFlagsClear(), osEventFlagsGet(), osEventFlagsWait(), osEventFlagsDelete() |
 * | Mutexes | osMutexNew(), osMutexAcquire(), osMutexRelease(), osMutexGetOwner(), osMutexDelete() |
 * | Semaphores | osSemaphoreNew(), osSemaphoreAcquire(), osSemaphoreRelease(), osSemaphoreGetCount(), osSemaphoreDelete() |
 * | Memory pools | osMemoryPoolNew(), osMemoryPoolGetName(), osMemoryPoolAlloc(), osMemoryPoolFree(), osMemoryPoolGetCapacity(), osMemoryPoolGetBlockSize(), osMemoryPoolGetCount(), osMemoryPoolGetSpace(), osMemoryPoolDelete() |
 * | Message queues | osMessageQueueNew(), osMessageQueuePut(), osMessageQueueGet(), osMessageQueueGetCapacity(), osMessageQueueGetMsgSize(), osMessageQueueGetCount(), osMessageQueueGetSpace(), osMessageQueueReset(), osMessageQueueDelete() |
 *
 * Not provided by the FreeRTOS layer (the build fails with "undefined
 * reference" if a sketch uses one): osKernelSuspend(), osKernelResume(),
 * osThreadGetStackSize(), osThreadJoin(), osThreadDetach(),
 * osEventFlagsGetName(), osMutexGetName(), osSemaphoreGetName(),
 * osMessageQueueGetName(), and the CMSIS-RTOS2 2.3 safety features:
 * osKernelProtect(), osKernelDestroyClass(), osThreadGetClass(),
 * osThreadGetZone(), osThreadSuspendClass(), osThreadResumeClass(),
 * osThreadTerminateZone(), osThreadFeedWatchdog(),
 * osThreadProtectPrivileged() and osFaultResume(). The attributes
 * `osThreadJoinable` and `osMutexRobust` make osThreadNew() and osMutexNew()
 * return NULL.
 */

/**
 * @defgroup core_types Constants and types
 * @brief Pin levels and modes, bit order, and the Arduino integer types.
 */

/*
 * Not part of Common.h: the members are in the variant's stusb4500.h. Defined
 * here so it comes after the Arduino topics (Topics follow INPUT order).
 */

/**
 * @defgroup usbpd USB-PD power
 * @brief stusb4500: sink profiles, renegotiation and the current contract.
 *
 * Needs `#include <stusb4500.h>`. See stusb4500.h for how the profiles work
 * and the UsbPdPower.ino example.
 */

/* ============================================================================ */
/*  Digital I/O                                                                  */
/* ============================================================================ */

/**
 * @fn void pinMode(pin_size_t pinNumber, PinMode pinMode)
 * @ingroup core_digital
 * @brief Sets a pin as an input or an output.
 *
 * Also stops analogWrite() or tone() output on the pin and returns it to a
 * plain digital pin.
 * @param pinNumber Arduino pin (e.g. 2, A0, LED_BUILTIN). A3-A5 and numbers
 *                  out of range are ignored.
 * @param pinMode   One of:
 *                  - INPUT: no pull resistor.
 *                  - INPUT_PULLUP, INPUT_PULLDOWN: the RP2040's weak internal
 *                    pull-up or pull-down.
 *                  - OUTPUT: driven high or low.
 *                  - OUTPUT_OPENDRAIN: driven low, or released (floating) for
 *                    HIGH. Needs a pull-up resistor.
 * @warning The pins are 3.3 V and not 5 V tolerant: do not connect a 5 V
 *          signal directly.
 */

/**
 * @fn void digitalWrite(pin_size_t pinNumber, PinStatus status)
 * @ingroup core_digital
 * @brief Sets an output pin HIGH (3.3 V) or LOW (0 V).
 *
 * What it does depends on the pin's mode:
 * - OUTPUT: drives the pin.
 * - OUTPUT_OPENDRAIN: LOW drives the pin low, HIGH releases it.
 * - INPUT: HIGH turns on the pull-up and LOW turns it off, as on an Uno.
 *
 * @param pinNumber Arduino pin. A3-A5 and numbers out of range are ignored.
 * @param status    HIGH or LOW.
 * @note Unlike an Uno, digitalWrite() does not stop analogWrite() or tone()
 *       output: call pinMode() first to use the pin as a plain output again.
 */

/**
 * @fn PinStatus digitalRead(pin_size_t pinNumber)
 * @ingroup core_digital
 * @brief Reads the level on a pin.
 *
 * Works in any mode, including OUTPUT (it reads back the pin). Inputs are
 * HIGH above about 2 V and LOW below about 0.8 V.
 * @param pinNumber Arduino pin.
 * @return HIGH or LOW. Always LOW for A3-A5 and numbers out of range.
 * @note After analogRead() on A0-A2, call pinMode() before digitalRead() on
 *       that pin: analogRead() turns off its digital input.
 */

/* ============================================================================ */
/*  Analog I/O                                                                   */
/* ============================================================================ */

/**
 * @fn int analogRead(pin_size_t pinNumber)
 * @ingroup core_analog
 * @brief Reads the voltage on an analog pin.
 *
 * | Pin | ADC | Full scale |
 * |---|---|---|
 * | A0-A2 | RP2040 ADC | 3.3 V |
 * | A3-A5 | On-board MAX11635 (max11635::read()) | 2.048 V |
 *
 * Both are 12-bit ADCs. The result is scaled to analogReadResolution(), 10
 * bits (0-1023) by default as on an Uno.
 * @param pinNumber A0-A5.
 * @return 0 to 2^bits - 1, where bits is the analogReadResolution() setting.
 *         0 for a pin that is not analog.
 * @note Use the names A0-A5. `analogRead(0)` reads D0, which is not an
 *       analog pin, and returns 0; on an Uno it would read A0.
 * @note Full scale differs between A0-A2 and A3-A5, so the same reading means
 *       a different voltage. At 10 bits: volts = `reading * 3.3 / 1023` on
 *       A0-A2, and `reading * 2.048 / 1023` on A3-A5.
 */

/**
 * @fn void analogReference(uint8_t mode)
 * @ingroup core_analog
 * @brief Does nothing: the references are fixed on Phyduino boards.
 *
 * A0-A2 use the 3.3 V supply; A3-A5 use the 2.048 V LM4040 reference (U7) on
 * the AREF pin.
 * @param mode Ignored.
 */

/**
 * @fn void analogWrite(pin_size_t pinNumber, int value)
 * @ingroup core_analog
 * @brief Outputs a PWM signal: a square wave whose duty cycle sets the average voltage.
 *
 * Unlike an Uno, every pin except A3-A5 can do PWM. The defaults match an
 * Uno: 8 bits (0-255) at 1000 Hz; see analogWriteResolution() and
 * analogWriteFrequency(). Call it again to change the duty cycle; pinMode()
 * stops it.
 *
 * The RP2040 has 8 PWM "slices". The pins on a slice share one frequency,
 * set by the last analogWrite() or tone() on any of them. Pins on the same
 * channel also share the duty cycle: both output what was last written to
 * either.
 *
 * | Slice | Channel A | Channel B |
 * |---|---|---|
 * | 0 | D1, D8 | D0, D9 |
 * | 2 | | LED_BUILTIN |
 * | 3 | D2 | D3 |
 * | 4 | D4, SDA | D5, SCL |
 * | 5 | D6, A0 | D11, A1 |
 * | 6 | D12, A2 | D10 |
 * | 7 | D13 | D7 |
 *
 * @param pinNumber Arduino pin. A3-A5 and numbers out of range are ignored.
 * @param value     0 (always LOW) to 2^bits - 1 (always HIGH), where bits is
 *                  the analogWriteResolution() setting. Values outside the
 *                  range are clamped.
 */

/* ============================================================================ */
/*  Advanced I/O                                                                 */
/* ============================================================================ */

/**
 * @fn void tone(uint8_t _pin, unsigned int frequency, unsigned long duration)
 * @ingroup core_advanced
 * @brief Plays a square wave (50 % duty) on a pin, for a buzzer or speaker.
 *
 * Returns at once; the tone plays in the background. Only one tone plays at a
 * time: starting a tone stops the previous one, on any pin. When it stops,
 * the pin becomes an input.
 *
 * The tone uses the pin's PWM slice, so it also changes the frequency of
 * analogWrite() on the other pins of that slice (see analogWrite()).
 * @param _pin      Arduino pin. A3-A5 and numbers out of range are ignored.
 * @param frequency Frequency in Hz; 0 is ignored. The lowest is about 8 Hz
 *                  at the default 133 MHz CPU speed.
 * @param duration  Length in ms; 0 (the default) plays until noTone().
 */

/**
 * @fn void noTone(uint8_t _pin)
 * @ingroup core_advanced
 * @brief Stops the tone, if one is playing on this pin.
 * @param _pin Arduino pin.
 */

/**
 * @fn unsigned long pulseIn(pin_size_t pin, uint8_t state, unsigned long timeout)
 * @ingroup core_advanced
 * @brief Measures how long a pulse on a pin lasts.
 *
 * If the pin is already at `state`, waits for that pulse to end first, then
 * times the next one. Timing uses the microsecond timer, so it is accurate
 * even with interrupts running. Blocks until the pulse ends or the timeout.
 * @param pin     Arduino pin (an input).
 * @param state   HIGH to time a high pulse, LOW for a low pulse.
 * @param timeout Longest time to wait for the whole measurement, in µs;
 *                1000000 (1 s) by default.
 * @return Pulse length in µs, or 0 on timeout or for A3-A5.
 */

/**
 * @fn unsigned long pulseInLong(pin_size_t pin, uint8_t state, unsigned long timeout)
 * @ingroup core_advanced
 * @brief Same as pulseIn(); kept for Arduino compatibility.
 * @param pin     Arduino pin (an input).
 * @param state   HIGH or LOW.
 * @param timeout Longest time to wait, in µs; 1000000 (1 s) by default.
 * @return Pulse length in µs, or 0 on timeout.
 */

/**
 * @fn void shiftOut(pin_size_t dataPin, pin_size_t clockPin, BitOrder bitOrder, uint8_t val)
 * @ingroup core_advanced
 * @brief Sends a byte one bit at a time, pulsing the clock pin after each bit.
 *
 * For shift registers such as the 74HC595. Set both pins to OUTPUT first.
 * The data bit is set while the clock is low and read by the chip on the
 * rising edge.
 * @param dataPin  Arduino pin for data.
 * @param clockPin Arduino pin for the clock.
 * @param bitOrder MSBFIRST or LSBFIRST.
 * @param val      Byte to send.
 */

/**
 * @fn uint8_t shiftIn(pin_size_t dataPin, pin_size_t clockPin, BitOrder bitOrder)
 * @ingroup core_advanced
 * @brief Reads a byte one bit at a time, pulsing the clock pin for each bit.
 *
 * For shift registers such as the 74HC165. Set the clock pin to OUTPUT and
 * the data pin to INPUT first. Each bit is read while the clock is high.
 * @param dataPin  Arduino pin for data.
 * @param clockPin Arduino pin for the clock.
 * @param bitOrder MSBFIRST or LSBFIRST.
 * @return Byte received.
 */

/* ============================================================================ */
/*  Time                                                                         */
/* ============================================================================ */

/**
 * @fn unsigned long millis(void)
 * @ingroup core_time
 * @brief Milliseconds since the board started.
 * @return Time in ms. Goes back to 0 after about 49.7 days.
 */

/**
 * @fn unsigned long micros(void)
 * @ingroup core_time
 * @brief Microseconds since the board started, with 1 µs resolution (4 µs on an Uno).
 * @return Time in µs. Goes back to 0 after about 71.6 minutes, so compare
 *         times by subtracting: `micros() - start`.
 */

/**
 * @fn void delay(unsigned long)
 * @ingroup core_time
 * @brief Waits a number of milliseconds.
 *
 * Interrupts, USB Serial and tones keep running. Calls yield() while waiting.
 * With FreeRTOS it blocks the calling task, so other tasks run meanwhile
 * (@ref core_freertos).
 */

/**
 * @fn void delayMicroseconds(unsigned int us)
 * @ingroup core_time
 * @brief Waits a number of microseconds, exactly, by busy-waiting.
 * @param us Time in µs.
 */

/* ============================================================================ */
/*  Interrupts                                                                   */
/* ============================================================================ */

/**
 * @fn void attachInterrupt(pin_size_t interruptNumber, voidFuncPtr callback, PinStatus mode)
 * @ingroup core_interrupts
 * @brief Calls a function when the level on a pin changes.
 *
 * Unlike an Uno (D2 and D3 only), every pin except A3-A5 can interrupt.
 * Replaces any function already attached to the pin.
 * @param interruptNumber `digitalPinToInterrupt(pin)`, which is just the pin number.
 * @param callback Function to call; nullptr is ignored.
 * @param mode     RISING, FALLING or CHANGE; or LOW or HIGH, which call the
 *                 function again as soon as it returns, for as long as the
 *                 level lasts.
 * @warning The function runs inside the interrupt: keep it short, make
 *          variables it shares with loop() `volatile`, and do not use Serial
 *          or delay() in it.
 */

/**
 * @fn void attachInterruptParam(pin_size_t interruptNumber, voidFuncPtrParam callback, PinStatus mode, void* param)
 * @ingroup core_interrupts
 * @brief Same as attachInterrupt(), but the function is called with `param`.
 * @param interruptNumber `digitalPinToInterrupt(pin)`, which is just the pin number.
 * @param callback Function taking a `void*`; nullptr is ignored.
 * @param mode     As for attachInterrupt().
 * @param param    Passed to `callback` on every call.
 */

/**
 * @fn void detachInterrupt(pin_size_t interruptNumber)
 * @ingroup core_interrupts
 * @brief Stops calling the function attached to a pin.
 * @param interruptNumber `digitalPinToInterrupt(pin)`, which is just the pin number.
 */

/* ============================================================================ */
/*  Sketch structure                                                             */
/* ============================================================================ */

/**
 * @fn void setup(void)
 * @ingroup core_sketch
 * @brief Written by the sketch: runs once after reset, on core 0.
 *
 * USB Serial is already running; add `while (!Serial) {}` to wait for the
 * Serial Monitor before printing. With FreeRTOS, setup() and loop() run in a
 * task (@ref core_freertos).
 */

/**
 * @fn void loop(void)
 * @ingroup core_sketch
 * @brief Written by the sketch: runs over and over after setup(), on core 0.
 */

/**
 * @fn void yield(void)
 * @ingroup core_sketch
 * @brief Called while delay() or USB Serial is waiting.
 *
 * Does nothing unless the sketch defines its own; with FreeRTOS, it lets
 * other tasks of the same priority run.
 */

/**
 * @fn void init(void)
 * @ingroup core_sketch
 * @brief Core start-up, before setup(): sets the CPU speed (Tools > CPU Speed), the ADC, USB and the inter-core FIFO.
 */

/**
 * @fn void initVariant(void)
 * @ingroup core_sketch
 * @brief Board start-up, after init(): the on-board ADC and the USB-PD controller.
 */

/* ============================================================================ */
/*  Math                                                                         */
/* ============================================================================ */

/**
 * @fn auto min(const T& a, const L& b) -> decltype((b < a) ? b : a)
 * @ingroup core_math
 * @brief The smaller of two values.
 * @tparam T Type of `a`.
 * @tparam L Type of `b`.
 * @param a First value.
 * @param b Second value.
 * @return `b` if it is less than `a`, otherwise `a`.
 */

/**
 * @fn auto max(const T& a, const L& b) -> decltype((b < a) ? b : a)
 * @ingroup core_math
 * @brief The larger of two values.
 * @tparam T Type of `a`.
 * @tparam L Type of `b`.
 * @param a First value.
 * @param b Second value.
 * @return `b` if `a` is less than it, otherwise `a`.
 */

/**
